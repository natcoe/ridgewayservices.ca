      </div>

      <div class="feature">
        <div class="icon">
          <span class="material-symbols-outlined">check_circle</span>
        </div>
        <h3>On Time, On Budget</h3>
        <p>We deliver projects with precision and accountability</p>
      </div>

      <div class="feature">
        <div class="icon">
          <span class="material-symbols-outlined">handshake</span>
        </div>
