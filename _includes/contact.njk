            <textarea name="message"></textarea>
          </label>
          <!-- your other form fields go here --> #}
          <button type="submit" class="btn btn-secondary">Submit</button>

          <span class="micetype">
            <p class="micetype">
              By submitting this form, you agree that Ridgeway Services & Construction Ltd. 
