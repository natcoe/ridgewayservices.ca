<section class="contact-section">
  <div class="container">
    <div class="contact-split">
      <div class="contact-info">
        <h2>Let's Build Something Great</h2>
        <p>Have a project in mind?<br />We'd love to hear about it.</p>

        <ul class="contact-details">
          <li>
            <span class="material-symbols-outlined">call</span>
            <a href="tel:{{ site.phone }}">
              {{ site.phone }}
            </a>
          </li>
          <li>
            <span class="material-symbols-outlined">mail</span>
            <a href="mailto:{{ site.email }}">
              {{ site.email }}
            </a>
          </li>
          <li>
            <span class="material-symbols-outlined">location_on</span>
            <span>
              {{ site.address }}
            </span>
          </li>
        </ul>
      </div>

      <div class="contact-form">
        <h2>Send us a Message</h2>

        {# <form action="#" method="POST">
          <div class="form-row">
            <input type="text" name="name" placeholder="Name*" required />
            <input type="email" name="email" placeholder="Email*" required />
            <input type="tel" name="phone" placeholder="Phone*" required />
          </div>

          <textarea name="message" placeholder="Message*" rows="5" required></textarea>

          <button type="submit" class="btn btn-secondary">Submit</button>

          <span class="micetype">
            <p class="micetype">
              By submitting this form, you agree that Ridgeway Services & Construction Ltd. 
              may use your information to respond to your inquiry.
            </p>
          </span>
        </form> #}

        <form
          action="https://formspree.io/f/xkjwweep"
          method="POST"
        >
          <div class="form-row">
            <input type="text" name="name" placeholder="Name*" required />
            <input type="email" name="email" placeholder="Email*" required />
            <input type="tel" name="phone" placeholder="Phone*" required />
          </div>

          <textarea name="message" placeholder="Message*" rows="5" required></textarea>
          {# <label>
            Your email:
            <input type="email" name="email">
          </label>
