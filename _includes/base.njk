<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <script src="/scripts/scripts.js" defer></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=apartment,assignment,balance,build,calendar_month,call,check_circle,design_services,expand_more,group,groups,handshake,handyman,history,home_repair_service,how_to_reg,location_on,mail,verified_user,workspace_premium" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Oswald:wght@200..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
  </head>
  <body>

    <!-- Staging password gate -->
    <div id="staging-gate" class="staging-gate" aria-hidden="false">
      <div class="staging-gate-card">
        <div class="staging-gate-logo">
          <img
            src="/images/ridgeway-logo-white.svg"
            alt="Ridgeway Services & Construction Ltd."
          >
        </div>
        <div class="staging-gate-content">
          <span class="staging-gate-eyebrow">
            Staging Site
          </span>
          <h1>Private Preview</h1>
          <p>
            This site is currently being prepared for launch.
            Please enter the password to continue.
          </p>
          <form id="staging-login-form" class="staging-login-form">
            <label for="staging-password" class="sr-only">
              Password
            </label>
            <input
              type="password"
              id="staging-password"
              name="password"
              placeholder="Password"
              autocomplete="off"
              required
            >
            <button type="submit" class="btn btn-primary">
              Enter Site
            </button>
            <p
              id="staging-error"
              class="staging-error"
              role="alert"
              hidden
            >
              Incorrect password. Please try again.
            </p>
          </form>
        </div>
      </div>
    </div>

    {% include "header.njk" %}

    <main>
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}

  </body>
</html>