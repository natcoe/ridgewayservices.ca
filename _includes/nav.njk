{% macro renderNav(items, level=1) %}

{% for item in items %}

{% set hasChildren = item.children and item.children.length > 0 %}


<div class="
  {% if level == 1 %}
    nav-item
  {% else %}
    submenu-item
  {% endif %}
  {% if hasChildren %}
    has-children
  {% endif %}
">


{% if hasChildren %}


    <div class="menu-header">

        <a href="{{ item.url }}" class="nav-link">
            {{ item.title }}
        </a>

        <button 
          class="menu-toggle"
          aria-expanded="false"
          aria-label="Expand {{ item.title }}"
        >
          <span class="caret">▾</span>
        </button>

    </div>


    <div class="
      {% if level == 1 %}
        dropdown-menu
      {% else %}
        submenu-menu
      {% endif %}
    ">

        {{ renderNav(item.children, level + 1) }}

    </div>


{% else %}


    <a href="{{ item.url }}" class="nav-link">
        {{ item.title }}
    </a>


{% endif %}


</div>


{% endfor %}

{% endmacro %}


<nav class="site-nav" aria-label="Primary navigation">

  {{ renderNav(navigation) }}

</nav>